
{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 18199,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 18299,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 18399,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 18499,
      "host": "127.0.0.1"
    },
    "hosting": {
      "port": 18599,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true,
      "port": 14002,
      "host": "127.0.0.1"
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
